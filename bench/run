#!/bin/bash
# Benchmark Alias Calc against omacalc and GNOME Calculator and print one
# table. Needs a Hyprland session; the windows open on the current workspace.
#
#   bench/run [--runs N]
#
# omacalc comes from $OMACALC, else `omacalc` on PATH, else it's skipped.
# Build it from https://github.com/omacom/omacalc with `bin/build`.
# GNOME Calculator must not already be running (it would hand off to the
# running copy instead of starting).

set -euo pipefail
cd "$(dirname "$0")/.."

runs=10
if [[ ${1:-} == --runs ]]; then runs=$2; fi

cargo build --release --locked --quiet

# Measure every app as the floating window it is in daily use (aliasOS
# floats GNOME Calculator already). The rule lasts until Hyprland reloads
# its config.
hyprctl eval 'hl.window_rule({ match = { class = [[^(com\.aliasproject\.calc|omacalc|org\.gnome\.Calculator)$]] }, float = true })' >/dev/null
results=()

bench() {
  local name=$1 class=$2
  shift 2
  local row
  if row=$(python3 -I bench/calcbench.py --runs "$runs" "$name" "$class" -- "$@"); then
    results+=("$row")
  fi
}

bench alias-calc com.aliasproject.calc target/release/alias-calc

omacalc=${OMACALC:-$(command -v omacalc || true)}
if [[ -n $omacalc ]]; then
  bench omacalc omacalc "$omacalc"
else
  echo "Skipping omacalc: set OMACALC or put omacalc on PATH." >&2
fi

if command -v gnome-calculator >/dev/null; then
  if pgrep -f '(^|/)gnome-calculator( |$)' >/dev/null; then
    echo "Skipping GNOME Calculator: it's already running." >&2
  else
    bench gnome-calculator org.gnome.calculator gnome-calculator
  fi
fi

printf '%s\n' "${results[@]}" | python3 -I bench/calcbench.py --table
